# ============================================================
# Smart Pricing Engine — .gitignore
# ============================================================

# ── Java / Maven ──
target/
*.class
*.jar
*.war
!target/*-shaded.jar

# ── IDE ──
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath
.metadata/

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ── Data Files (大型数据集不入库) ──
data/raw/*.csv
data/raw/*.zip
data/raw/*.gz
data/output/*.parquet
data/output/*.csv
!data/raw/.gitkeep
!data/output/.gitkeep

# ── Logs ──
logs/
*.log
*.log.*

# ── Environment / Secrets ──
.env
.env.local
*.env
!docker/.env.example

# ── Docker ──
docker-compose.override.yml

# ── Node (if any) ──
node_modules/
package-lock.json

# ── Temporary ──
tmp/
temp/
_to_delete/
*.bak
*.tmp

# ── Archive ──
*.zip
*.tar.gz
*.rar
